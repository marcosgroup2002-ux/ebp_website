# Configuration Supabase pour EBP (valeurs publiques : la sécurité repose sur la RLS)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# IMPORTANT : toute variable VITE_* est intégrée au JavaScript envoyé aux visiteurs.
# Ne jamais y placer de secret (clé Resend, service_role, mot de passe...).
# Les secrets serveur se configurent avec : supabase secrets set RESEND_API_KEY=... PDG_ALERT_EMAIL=...
